# =============================================================================
# OOP sample 3: inheritance (ikomoka, override, constructor rules)
# =============================================================================
#
# KEYWORDS USED IN THIS FILE
# --------------------------
# imiterere          declare a class
# ikomoka            single inheritance: child comes from one parent class
# tegura             constructor (child tegura fully replaces parent tegura)
# rema               create an instance
# _                  current instance
# rusange / bwite    public / private visibility
# porogaramu_ntoya   method
# reka               local binding
# tangaza_amakuru    print
# tanga              return from a method
#
# BEHAVIOR THIS FILE SHOWS
# ------------------------
# 1. imiterere Child ikomoka Parent { ... } is single inheritance only.
# 2. Method lookup starts on the instance's class and walks parents upward.
# 3. A child method with the same name fully replaces the parent method.
# 4. A child with no tegura inherits the parent's constructor and its params.
# 5. A child tegura fully replaces the parent constructor. The parent tegura
#    does not run, so the child must set any fields its own methods need.
# 6. Public parent methods that only need fields the child set still work.
# 7. Parent private helpers stay usable through public parent methods when
#    the inherited constructor created the private fields.
#
# =============================================================================

# Parent class: shared shape and default behavior.
imiterere Umuntu {
  tegura(izina, imyaka) {
    rusange _.izina = izina
    rusange _.imyaka = imyaka
    bwite _.ibanga = "secret"
  }

  rusange porogaramu_ntoya kwibwira() {
    tangaza_amakuru("Nitwa ", _.izina, ", mfite imyaka ", _.imyaka)
  }

  rusange porogaramu_ntoya imyaka_yose() {
    tanga _.imyaka
  }

  bwite porogaramu_ntoya soma_ibanga() {
    tanga _.ibanga
  }

  # Public wrapper around a private helper.
  rusange porogaramu_ntoya tangaza_ibanga() {
    tangaza_amakuru(_.soma_ibanga())
  }
}

# Child with no tegura: inherits parent's constructor (izina, imyaka).
imiterere Umwarimu ikomoka Umuntu {
  # Overrides parent method completely.
  rusange porogaramu_ntoya kwibwira() {
    tangaza_amakuru("Ndi umwarimu, nitwa ", _.izina)
  }

  # New method only on the child.
  rusange porogaramu_ntoya yigisha(isomo) {
    tangaza_amakuru(_.izina, " yigisha ", isomo)
  }

  # Child may use public parent fields set by the inherited constructor.
  rusange porogaramu_ntoya imyaka_yigisha() {
    tangaza_amakuru(_.izina, " afite imyaka ", _.imyaka)
  }
}

# Inherited constructor: same parameters as Umuntu tegura.
reka mwalimu = rema Umwarimu("Keza", 28)
mwalimu.kwibwira()
mwalimu.yigisha("matematiki")
mwalimu.imyaka_yigisha()
tangaza_amakuru(mwalimu.imyaka_yose())

# Inherited constructor set private fields, so parent public wrappers work.
mwalimu.tangaza_ibanga()

# Child that declares its own tegura: parent tegura does not run.
# This child sets every field its own methods need.
imiterere Umunyeshuri ikomoka Umuntu {
  tegura(izina, ishuri) {
    rusange _.izina = izina
    rusange _.ishuri = ishuri
  }

  rusange porogaramu_ntoya kwibwira() {
    tangaza_amakuru("Ndi umunyeshuri, nitwa ", _.izina)
  }

  rusange porogaramu_ntoya tangaza_ishuri() {
    tangaza_amakuru(_.izina, " yiga mu ", _.ishuri)
  }
}

reka umunyeshuri = rema Umunyeshuri("Aline", "GS Remera")
umunyeshuri.kwibwira()
umunyeshuri.tangaza_ishuri()
