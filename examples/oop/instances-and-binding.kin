# =============================================================================
# OOP sample 5: instances, method binding, sealed fields, and _
# Feature design: Kin issue #258 (Object Oriented Programming)
# Status: documentation sample. Requires the OOP implementation to run.
# =============================================================================
#
# KEYWORDS USED IN THIS FILE
# --------------------------
# imiterere          declare a class
# tegura             constructor
# rema               create an instance (binds tighter than binary ops, looser
#                    than member access: rema C("x").method() is valid)
# _                  reserved: current instance only in tegura / method bodies
# rusange / bwite    public / private
# porogaramu_ntoya   method or nested plain function
# reka               mutable binding
# ntahinduka         constant binding (cannot rebind the name)
# tangaza_amakuru    print
# tanga              return
#
# BEHAVIOR THIS FILE SHOWS
# ------------------------
# 1. Methods are bound when accessed. reka f = keza.kwibwira still has the
#    correct _ when f is called later (not a free/unbound this).
# 2. Instance shape is sealed after tegura finishes. New field names are
#    errors; missing field reads are errors (not ubusa).
# 3. Methods may assign existing fields with _.NAME = value (no modifier).
# 4. Nested porogaramu_ntoya inside a method does NOT capture _. Using _ in
#    the nested function is an error.
# 5. Bare _ is reserved. reka _ = 5, parameters named _, imiterere _ are errors.
#    Identifiers that only contain underscore characters elsewhere are fine:
#    _izina, izina_rya_mbere remain ordinary names.
# 6. ntahinduka p = rema ... prevents rebinding p. It does not freeze fields.
#    Mutating a field of a constant binding is allowed.
# 7. Fields may hold any runtime value: arrays, plain objects, functions,
#    other instances. Nested access like _.abana[0].izina must work.
# 8. Classes are first-class: pass a class value into a function and rema it.
#
# =============================================================================

imiterere Umuntu {
  tegura(izina, imyaka) {
    rusange _.izina = izina
    rusange _.imyaka = imyaka
    rusange _.abana = []
  }

  rusange porogaramu_ntoya kwibwira() {
    tangaza_amakuru("Nitwa ", _.izina, ", mfite imyaka ", _.imyaka)
  }

  rusange porogaramu_ntoya shyira_imyaka(imyaka_nshya) {
    # Existing field: no visibility modifier inside methods.
    _.imyaka = imyaka_nshya
  }

  rusange porogaramu_ntoya ongeramo_umwana(umwana) {
    # Field may hold an array; push-style work is manual with assignment.
    # (Exact array helpers depend on stdlib; here we reassign a longer list.)
    reka nshya = [umwana]
    # If the runtime supports growing arrays another way, use that; this
    # sample focuses on storing instances in fields.
    _.abana = nshya
  }

  rusange porogaramu_ntoya izina_ryumwana_wa_mbere() {
    tanga _.abana[0].izina
  }

  # Nested plain function must not see the method's _.
  rusange porogaramu_ntoya gerageza_nested() {
    porogaramu_ntoya imbere() {
      # Using _ here must be an error: nested functions do not capture _.
      # tangaza_amakuru(_.izina)
      tangaza_amakuru("nested function nta _ ifite")
    }
    imbere()
  }
}

# rema then member access: construct and call in one expression.
rema Umuntu("Keza", 20).kwibwira()

reka keza = rema Umuntu("Keza", 20)
keza.kwibwira()

# Bound method: keeps the correct receiver.
reka f = keza.kwibwira
f()

# Mutate an existing public field from top level.
keza.imyaka = 21
tangaza_amakuru(keza.imyaka)
keza.shyira_imyaka(22)
tangaza_amakuru(keza.imyaka)

# Constant binding of an instance: name is fixed, fields still change.
ntahinduka p = rema Umuntu("Aline", 18)
p.imyaka = 19
tangaza_amakuru(p.imyaka)
# This would fail (cannot rebind a ntahinduka name):
# p = rema Umuntu("Other", 1)

# Nested instance stored in a field.
reka umwana = rema Umuntu("Beza", 5)
keza.ongeramo_umwana(umwana)
tangaza_amakuru(keza.izina_ryumwana_wa_mbere())

keza.gerageza_nested()

# Classes are first-class values.
porogaramu_ntoya rema_umuntu(ClassValue, izina, imyaka) {
  tanga rema ClassValue(izina, imyaka)
}

reka undi = rema_umuntu(Umuntu, "Eric", 25)
undi.kwibwira()

# Ordinary identifiers that contain underscores are fine (not the bare _).
reka _izina = "ok"
reka izina_rya_mbere = "also ok"
tangaza_amakuru(_izina)
tangaza_amakuru(izina_rya_mbere)

# ---------------------------------------------------------------------------
# MUST FAIL when uncommented
# ---------------------------------------------------------------------------
# New field after construction (shape is sealed):
# keza.aho_atuye = "Kigali"
#
# Read a field that does not exist:
# tangaza_amakuru(keza.numero)
#
# Bare _ outside method/constructor:
# tangaza_amakuru(_)
#
# Cannot declare or parameterize bare _:
# reka _ = 5
# porogaramu_ntoya bad(_) { tanga 1 }
#
# tanga with a value inside tegura is an error:
# imiterere Bad {
#   tegura() {
#     tanga 1
#   }
# }
#
# Wrong argument count:
# reka x = rema Umuntu("Keza")
