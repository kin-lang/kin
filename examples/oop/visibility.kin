# =============================================================================
# OOP sample 2: visibility (rusange vs bwite on fields and methods)
# =============================================================================
#
# KEYWORDS USED IN THIS FILE
# --------------------------
# imiterere          declare a class
# tegura             constructor
# rema               create an instance
# _                  current instance (constructor / method body only)
# rusange            public: readable, writable, callable from anywhere
# bwite              private: only inside methods/constructor of THIS class
# porogaramu_ntoya   method declaration (must have rusange or bwite)
# reka               local binding
# tangaza_amakuru    print
# tanga              return from a method
#
# BEHAVIOR THIS FILE SHOWS
# ------------------------
# 1. Fields get their visibility when first assigned in tegura. The modifier
#    is required there. Later, methods assign with _.NAME = value (no modifier).
# 2. rusange members work from top level: read, write, call.
# 3. bwite members work only from inside a method or constructor of the class
#    that declared them. Outside code uses public methods that wrap them.
# 4. A public method may use private fields and private methods freely.
# 5. Methods may update existing private fields without a visibility modifier.
#
# =============================================================================

imiterere Umuntu {
  tegura(izina, imyaka) {
    rusange _.izina = izina
    # Private field: only this class's methods and tegura may touch it.
    bwite _.imyaka = imyaka
  }

  # Public API that uses private state internally.
  rusange porogaramu_ntoya kwibwira() {
    tangaza_amakuru("Nitwa ", _.izina, ", mfite imyaka ", _.imyaka)
  }

  # Private helper method: only callable from inside this class.
  bwite porogaramu_ntoya umwaka_avuka() {
    tanga 2026 - _.imyaka
  }

  # Public method that calls a private method through _.
  rusange porogaramu_ntoya tangaza_umwaka_avuka() {
    tangaza_amakuru("Yavutse mu ", _.umwaka_avuka())
  }

  # Methods may update existing fields without a visibility modifier.
  rusange porogaramu_ntoya shyira_imyaka(imyaka_nshya) {
    _.imyaka = imyaka_nshya
  }

  # Public fields on another instance are fine from a method.
  rusange porogaramu_ntoya gereranya_izina(undi) {
    tangaza_amakuru("Undi ni ", undi.izina)
  }
}

reka keza = rema Umuntu("Keza", 20)
reka mukuru = rema Umuntu("Mukuru", 30)

# Public field: readable and writable from top level.
tangaza_amakuru(keza.izina)
keza.izina = "Keza Nshya"
tangaza_amakuru(keza.izina)

# Public methods: callable from top level. Private state stays behind them.
keza.kwibwira()
keza.tangaza_umwaka_avuka()
keza.shyira_imyaka(21)
keza.kwibwira()

keza.gereranya_izina(mukuru)
